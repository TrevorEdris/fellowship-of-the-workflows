#!/usr/bin/env bash
set -euo pipefail

# Fellowship of the Workflows - Bootstrap
# Installs required dependencies via Homebrew

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Optional legacy dependencies (no longer required when Python CLI is available)
OPTIONAL_DEPS=("jq" "fzf" "yq")

show_help() {
    cat << 'EOF'
Usage: bootstrap [options]

Set up the fotw CLI environment.

Options:
  -h, --help         Show this help message
  -c, --check        Check only, don't install (exit 0 if all present, 1 if missing)
  -f, --force        Force reinstall all dependencies

Required:
  python3 (3.10+)    Python runtime for the fotw CLI

Optional (legacy bash fallback):
  jq                 JSON parsing (bash scripts only)
  fzf                Interactive selection (bash scripts only)
  yq                 YAML frontmatter parsing (bash scripts only)

Examples:
  bootstrap          Check and install missing dependencies
  bootstrap --check  CI-friendly check (exit code only)
  bootstrap --force  Reinstall all dependencies
EOF
}

check_only=false
force=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--check)
            check_only=true
            shift
            ;;
        -f|--force)
            force=true
            shift
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Run 'bootstrap --help' for usage."
            exit 1
            ;;
    esac
done

echo ""
echo "Fellowship of the Workflows - Bootstrap"
echo "========================================"
echo ""

# Check for Homebrew
if ! command -v brew &> /dev/null; then
    echo -e "${RED}✗ Homebrew not installed${NC}"
    echo ""
    echo "Install Homebrew first:"
    echo '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
    exit 1
fi

brew_version=$(brew --version | head -n1 | awk '{print $2}')
echo -e "${GREEN}✓${NC} brew ($brew_version)"

# Check optional legacy dependencies
optional_missing=()
for dep in "${OPTIONAL_DEPS[@]}"; do
    if command -v "$dep" &> /dev/null; then
        version=$("$dep" --version 2>/dev/null | head -n1 || echo "installed")
        echo -e "${GREEN}✓${NC} $dep ($version)"
    else
        echo -e "${YELLOW}!${NC} $dep (not installed — optional, needed for bash fallback only)"
        optional_missing+=("$dep")
    fi
done

echo ""

# Check Python 3.10+
python_ok=false
if command -v python3 &> /dev/null; then
    py_version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    py_major=$(echo "$py_version" | cut -d. -f1)
    py_minor=$(echo "$py_version" | cut -d. -f2)
    if [[ "$py_major" -gt 3 ]] || { [[ "$py_major" -eq 3 ]] && [[ "$py_minor" -ge 10 ]]; }; then
        echo -e "${GREEN}✓${NC} python3 ($py_version)"
        python_ok=true
    else
        echo -e "${RED}✗${NC} python3 ($py_version — need 3.10+)"
    fi
else
    echo -e "${RED}✗${NC} python3 (not installed)"
fi

# Check venv
if [[ -f "$REPO_ROOT/cli/.venv/bin/python" ]]; then
    echo -e "${GREEN}✓${NC} fotw CLI (cli/.venv/)"
else
    echo -e "${YELLOW}!${NC} fotw CLI (not installed — run bootstrap without --check)"
fi

echo ""

# If check only, exit with appropriate code
if $check_only; then
    if $python_ok; then
        echo "All required dependencies installed."
        [[ "${optional_missing[*]:-}" ]] && echo "Optional (legacy bash): ${optional_missing[*]}"
        exit 0
    else
        echo "Missing: Python 3.10+"
        exit 1
    fi
fi

# --- Python CLI setup ---
setup_python_cli() {
    echo ""
    echo "Setting up fotw CLI..."
    echo ""

    # Reuse the python_ok flag from the top-level check
    if ! $python_ok; then
        echo -e "${RED}✗ Python 3.10+ not available. Skipping CLI setup.${NC}"
        return 1
    fi

    # Create project-local venv
    local VENV_DIR="$REPO_ROOT/cli/.venv"
    if [[ ! -d "$VENV_DIR" ]] || $force; then
        echo "Creating Python virtualenv at cli/.venv/..."
        if command -v uv &>/dev/null; then
            uv venv "$VENV_DIR"
        else
            python3 -m venv "$VENV_DIR"
        fi
        echo -e "${GREEN}✓${NC} venv created"
    fi

    # Install fotw package into venv
    echo "Installing fotw CLI into venv..."
    if command -v uv &>/dev/null; then
        uv pip install --quiet -e "$REPO_ROOT/cli[dev]" -p "$VENV_DIR/bin/python"
    else
        "$VENV_DIR/bin/pip" install --quiet -e "$REPO_ROOT/cli[dev]"
    fi
    echo -e "${GREEN}✓${NC} fotw CLI installed (cli/.venv/)"
}

setup_python_cli || echo -e "${YELLOW}Warning: Python CLI setup failed. Bash bin/ scripts still work.${NC}"

echo ""
echo -e "${GREEN}All dependencies installed. Ready to go!${NC}"
